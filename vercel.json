{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },

  "trailingSlash": true,

  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/terms/terms-of-service/1.0.html",
      "destination": "/terms/terms-of-service/1.0",
      "permanent": true
    },
    {
      "source": "/terms/privacy-policy/1.0.html",
      "destination": "/terms/privacy-policy/1.0",
      "permanent": true
    },
    {
      "source": "/terms/sensitive-information-consent/1.0.html",
      "destination": "/terms/sensitive-information-consent/1.0",
      "permanent": true
    },
    {
      "source": "/terms/third-party-provision-consent/1.0.html",
      "destination": "/terms/third-party-provision-consent/1.0",
      "permanent": true
    },
    {
      "source": "/terms/cross-border-transfer-consent/1.0.html",
      "destination": "/terms/cross-border-transfer-consent/1.0",
      "permanent": true
    },
    {
      "source": "/terms/location-based-service-terms/1.0.html",
      "destination": "/terms/location-based-service-terms/1.0",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/terms/terms-of-service/1.0",
      "destination": "/terms/terms-of-service/1.0.html"
    },
    {
      "source": "/terms/privacy-policy/1.0",
      "destination": "/terms/privacy-policy/1.0.html"
    },
    {
      "source": "/terms/sensitive-information-consent/1.0",
      "destination": "/terms/sensitive-information-consent/1.0.html"
    },
    {
      "source": "/terms/third-party-provision-consent/1.0",
      "destination": "/terms/third-party-provision-consent/1.0.html"
    },
    {
      "source": "/terms/cross-border-transfer-consent/1.0",
      "destination": "/terms/cross-border-transfer-consent/1.0.html"
    },
    {
      "source": "/terms/location-based-service-terms/1.0",
      "destination": "/terms/location-based-service-terms/1.0.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/terms/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
