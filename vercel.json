{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },

  "//": "약관은 public/terms/{slug}/{version}.html 로 두고, 확장자 없는 주소로 이어 줍니다. 배포된 버전은 덮어쓰지 않고, 개정 시 새 파일과 새 rewrite 한 줄을 추가하세요.",
  "rewrites": [
    {
      "source": "/terms/terms-of-service/1.0",
      "destination": "/terms/terms-of-service/1.0.html"
    },
    {
      "source": "/terms/privacy-policy/1.0",
      "destination": "/terms/privacy-policy/1.0.html"
    },
    {
      "source": "/terms/sensitive-information-consent/1.0",
      "destination": "/terms/sensitive-information-consent/1.0.html"
    },
    {
      "source": "/terms/third-party-provision-consent/1.0",
      "destination": "/terms/third-party-provision-consent/1.0.html"
    },
    {
      "source": "/terms/cross-border-transfer-consent/1.0",
      "destination": "/terms/cross-border-transfer-consent/1.0.html"
    },
    {
      "source": "/terms/location-based-service-terms/1.0",
      "destination": "/terms/location-based-service-terms/1.0.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/terms/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
