---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy as c } from '../lib/copy';
import { BUSINESS } from '../lib/business';
import { DOWNLOAD_URL } from '../lib/links';

const title = c.meta.title;
const description = c.meta.description;

/**
 * 정규 주소.
 * 정적 빌드에서는 같은 페이지가 뒷슬래시 유무로 두 주소로 열릴 수 있어
 * 항상 뒷슬래시가 붙은 쪽을 정규 주소로 통일합니다.
 * (vercel.json의 trailingSlash: true가 뒷슬래시를 붙여 보내는 것과 같은 형태)
 */
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site ?? Astro.url.origin);

/** SNS 공유 이미지. */
const ogImage = new URL('/og/og.png', Astro.site ?? Astro.url.origin);

/**
 * 구조화 데이터(JSON-LD): 조직 + 웹사이트 + 앱.
 * - 사이트 내 검색이 없어 potentialAction(SearchAction)은 넣지 않습니다.
 * - 별점(aggregateRating)은 실제 값이 없으면 넣지 않습니다. 지어내면 안 됩니다.
 *   스토어 평점이 쌓이면 그때 실제 값으로 추가하세요.
 */
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Laimory',
      alternateName: '라이모리',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/brand/logo-512.png', siteUrl).href,
        width: 512,
        height: 512,
      },
      email: BUSINESS.email,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: BUSINESS.email,
        availableLanguage: ['Korean', 'English'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Laimory',
      alternateName: '라이모리',
      description,
      inLanguage: 'ko',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteUrl}#app`,
      name: 'Laimory',
      alternateName: '라이모리',
      description,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'Android',
      url: siteUrl,
      downloadUrl: DOWNLOAD_URL,
      installUrl: DOWNLOAD_URL,
      inLanguage: 'ko',
      publisher: { '@id': `${siteUrl}#organization` },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'KRW',
      },
    },
  ],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#262e46" />

    <!-- 검색엔진 소유 확인 (Google Search Console · 네이버 서치어드바이저 — windseed71 계정) -->
    <meta name="google-site-verification" content="v8mANuBXItjC1fdzWtIpxJKSQZbKqApnxVdKYS1qigU" />
    <meta name="naver-site-verification" content="756aad73c8176ba54a3f41c5094936b11edffd6f" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />

    <!-- SNS 공유 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Laimory" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={c.meta.ogImageAlt} />

    <!-- 구조화 데이터 (schema.org) — 검색엔진에게 조직·사이트 정보를 알립니다 -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    />

    <!--
      본문은 원본 디자인과 같은 Pretendard, 큰 제목은 Noto Sans KR,
      영문 라벨은 Inter를 씁니다.
    -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+KR:wght@400;500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
