---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useCopy } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);

const title = c.meta.title;
const description = c.meta.description;

/** 정규 주소와 언어별 대체 주소 */
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const alternates = [
  { hreflang: 'ko', href: new URL('/', Astro.site ?? Astro.url.origin).href },
  { hreflang: 'en', href: new URL('/en/', Astro.site ?? Astro.url.origin).href },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#262e46" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    <!-- SNS 공유 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Laimory" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!--
      본문·제목은 Noto Sans KR, 손글씨 느낌의 기록은 Gowun Batang,
      영문 라벨은 Inter, 앱 목업 안은 원본 디자인과 같은 Pretendard를 씁니다.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400&family=Inter:wght@400;500;600&family=Noto+Sans+KR:wght@400;500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
