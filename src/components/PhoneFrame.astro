---
/**
 * 화면 아래쪽이 잘려 올라오는 폰 목업 틀.
 * 안쪽 화면은 스크롤되는 앱의 윗부분만 보여주므로 높이를 넘긴 내용은 잘립니다.
 *
 * 목업은 그림이므로 role="img"로 묶어, 보조기기에는 안의 문구가 통째로
 * 읽히는 대신 label 한 줄만 전달됩니다.
 */
interface Props {
  /** 틀의 폭(px). 시안 기준 값을 넘기세요. 좁은 화면에서는 부모에 맞춰 줄어듭니다. */
  width?: number;
  /** 보이는 화면 높이(px) */
  height: number;
  /** lg: 히어로·개인정보 목업(테두리 12px), sm: 세 단계 목업(테두리 10px) */
  size?: 'lg' | 'sm';
  /** 히어로처럼 바닥에 그림자를 깔지 */
  shadow?: boolean;
  /**
   * 좁은 화면에서 높이를 460px까지 줄일지.
   * 캡처처럼 잘려도 되는 화면은 켜 두고, 버튼까지 다 보여야 하는 화면은 끕니다.
   */
  cap?: boolean;
  /** 스크린 리더에 읽힐 설명 */
  label: string;
}

const { width = 412, height, size = 'lg', shadow = false, cap = true, label } = Astro.props;
const sizeClass = 'phone--' + size;
const vars = '--phone-w: ' + width + 'px; --phone-h: ' + height + 'px';
---

<div
  class:list={['phone', sizeClass, { 'phone--shadow': shadow, 'phone--cap': cap }]}
  style={vars}
  role="img"
  aria-label={label}
>
  <div class="phone__screen">
    <slot />
  </div>
</div>

<style>
  .phone {
    width: min(var(--phone-w), 100%);
    height: var(--phone-h);
    padding: var(--phone-pad) var(--phone-pad) 0;
    box-sizing: border-box;
    border-radius: var(--phone-r) var(--phone-r) 0 0;
    background: var(--lm-ink);
    flex-shrink: 0;
  }

  .phone--lg {
    --phone-pad: 12px;
    --phone-r: 52px;
    --phone-r-in: 42px;
  }

  .phone--sm {
    --phone-pad: 10px;
    --phone-r: 36px;
    --phone-r-in: 28px;
  }

  .phone--shadow {
    box-shadow: 0 24px 60px rgb(0 0 0 / 35%);
  }

  .phone__screen {
    height: 100%;
    overflow: hidden;
    border-radius: var(--phone-r-in) var(--phone-r-in) 0 0;
    background: var(--lm-paper);
  }

  /* 화면이 좁아지면 큰 목업의 모서리를 조금 줄이고, 잘려도 되는 화면은 낮게 자릅니다. */
  @media (max-width: 640px) {
    .phone--lg {
      --phone-r: 44px;
      --phone-r-in: 34px;
    }

    .phone--lg.phone--cap {
      height: min(var(--phone-h), 460px);
    }
  }
</style>
