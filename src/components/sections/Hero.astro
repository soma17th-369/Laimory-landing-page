---
/**
 * 히어로. 왼쪽은 한 줄 약속과 CTA, 오른쪽은 실제 앱을 담은 폰 목업입니다.
 *
 * 목업 이미지가 기기 테두리까지 포함하고 배경이 투명해서, 목업 틀을 CSS로
 * 그리지 않고 이미지를 그대로 얹습니다. 아래는 이미 잘린 그림이라
 * 섹션 바닥에서 폰이 올라오는 모습이 됩니다.
 */
import { getLangFromUrl, useCopy } from '../../i18n/utils';
import { DOWNLOAD_URL, externalLinkAttrs } from '../../lib/links';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title lm-rise">
        {c.hero.titleLine1}<br />{c.hero.titleLine2}
      </h1>
      <p class="hero__body">{c.hero.body}</p>

      <div class="hero__actions">
        <a
          class="lm-btn lm-btn--primary hero__cta"
          href={DOWNLOAD_URL}
          {...externalLinkAttrs(DOWNLOAD_URL)}
        >
          {c.hero.ctaPrimary}
        </a>
        <a class="lm-btn lm-btn--ghost hero__cta" href="#how">
          {c.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="hero__device lm-rise lm-rise--after">
      <img
        class="hero__phone"
        src="/images/hero-phone.webp"
        alt={c.hero.deviceAlt}
        width="843"
        height="1057"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--lm-navy);
  }

  .hero__inner {
    width: 100%;
    max-width: var(--lm-page-max);
    margin-inline: auto;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: clamp(40px, 5vw, 72px);
    /* 아래 여백이 0이라 폰 목업이 섹션 바닥에 붙어 올라옵니다. */
    padding: clamp(56px, 7vw, 104px) var(--lm-gutter) 0;
  }

  .hero__copy {
    flex: 1;
    min-width: 0;
    padding: clamp(0px, 2vw, 32px) 0 clamp(56px, 7vw, 104px);
  }

  .hero__title {
    margin: 0;
    font-family: var(--lm-font-heading);
    font-weight: 700;
    font-size: clamp(32px, 4.1vw, 58px);
    line-height: 1.34;
    letter-spacing: -0.025em;
    color: #ffffff;
    text-wrap: pretty;
  }

  .hero__body {
    margin: 28px 0 0;
    max-width: 520px;
    font-weight: 400;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.8;
    color: var(--lm-primary-soft);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: clamp(32px, 3.4vw, 44px);
  }

  .hero__cta {
    padding: 18px clamp(24px, 2.6vw, 34px);
    font-size: clamp(15px, 1.3vw, 17px);
  }

  /* 목업은 글보다 아래에 맞춰 섹션 바닥에 붙습니다. */
  .hero__device {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
    align-self: flex-end;
    width: min(440px, 100%);
  }

  /* 목업 이미지에 기기 테두리가 들어 있어 그림자만 더합니다. */
  .hero__phone {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 24px 60px rgb(0 0 0 / 35%));
  }

  /* 세로로 쌓이면 목업이 글 아래에서 섹션 바닥에 붙습니다. */
  @media (max-width: 900px) {
    .hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .hero__copy {
      padding-bottom: clamp(40px, 6vw, 56px);
    }

    .hero__body {
      max-width: none;
    }

    .hero__device {
      align-self: center;
      width: min(440px, 100%);
    }
  }
</style>
