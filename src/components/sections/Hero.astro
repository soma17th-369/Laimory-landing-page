---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative overflow-hidden">
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-indigo-50 via-white to-white dark:from-slate-900 dark:via-slate-950 dark:to-slate-950"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-28 lg:py-32">
    <span
      class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1.5 text-sm font-medium text-brand dark:border-indigo-900 dark:bg-indigo-950/50"
    >
      {t('hero.badge')}
    </span>

    <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
      {t('hero.title')}
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      {t('hero.subtitle')}
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="#cta"
        class="w-full rounded-full bg-brand px-8 py-3 text-base font-semibold text-white shadow-lg shadow-indigo-500/20 transition hover:bg-brand-dark sm:w-auto"
      >
        {t('hero.cta_primary')}
      </a>
      <a
        href="#features"
        class="w-full rounded-full border border-slate-300 px-8 py-3 text-base font-semibold text-slate-700 transition hover:bg-slate-50 sm:w-auto dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
      >
        {t('hero.cta_secondary')}
      </a>
    </div>
  </div>
</section>
