---
import { getLangFromUrl, useCopy } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);

const tiles = [
  '/images/moment-1.jpg',
  '/images/moment-2.jpg',
  '/images/moment-3.jpg',
  '/images/moment-4.jpg',
];
---

<section class="moments">
  <div class="moments__inner lm-page">
    <div class="moments__copy">
      <h2 class="lm-h2 moments__title">{c.moments.title}</h2>
      <p class="lm-body moments__body">{c.moments.body}</p>
    </div>

    <div class="moments__grid">
      {
        tiles.map((src) => (
          <img class="moments__tile" src={src} alt={c.moments.imageAlt} loading="lazy" decoding="async" width="416" height="416" />
        ))
      }
    </div>
  </div>
</section>

<style>
  .moments {
    background: var(--lm-paper-2);
  }

  .moments__inner {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: clamp(40px, 5.5vw, 80px);
    padding: var(--lm-section-y) var(--lm-gutter);
  }

  .moments__copy {
    flex: 1;
    min-width: 0;
  }

  .moments__title {
    font-size: clamp(28px, 3.1vw, 40px);
  }

  .moments__body {
    margin: 24px 0 0;
    max-width: 460px;
  }

  .moments__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    width: min(430px, 100%);
    flex-shrink: 0;
  }

  .moments__tile {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }

  @media (max-width: 900px) {
    .moments__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(32px, 5vw, 44px);
    }

    .moments__body {
      max-width: none;
    }

    .moments__grid {
      width: 100%;
      align-self: center;
    }
  }
</style>
