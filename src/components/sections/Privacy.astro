---
/**
 * "어디까지 기록할지는 내가 정합니다."
 * 왼쪽 목업은 타임라인을 만들기 전 기록을 확인하는 화면, 오른쪽은 약속 네 가지입니다.
 */
import PhoneFrame from '../PhoneFrame.astro';
import ConsentScreen from '../ConsentScreen.astro';
import { getLangFromUrl, useCopy } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);
---

<section class="privacy" id="privacy">
  <div class="privacy__inner lm-page">
    <div class="privacy__device">
      <PhoneFrame width={412} height={620} cap={false} label={c.privacy.screen.title}>
        <ConsentScreen screen={c.privacy.screen} />
      </PhoneFrame>
    </div>

    <div class="privacy__copy">
      <h2 class="lm-h2 privacy__title">
        {c.privacy.titleLine1}<br />{c.privacy.titleLine2}
      </h2>
      <ul class="privacy__points">
        {
          c.privacy.points.map((point) => (
            <li class="privacy__point">
              <span class="privacy__when">{point.label}</span>
              <span class="privacy__promise">{point.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .privacy__inner {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: clamp(40px, 5.5vw, 80px);
    padding: var(--lm-section-y) var(--lm-gutter);
  }

  .privacy__device {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
  }

  .privacy__copy {
    flex: 1;
    min-width: 0;
  }

  /*
   * 두 문장뿐이라 구분선 대신 여백으로 뗍니다.
   * 문장 안 줄간격(24px)보다 확실히 넓어야 두 문장으로 읽힙니다.
   */
  .privacy__points {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 480px;
  }

  .privacy__point {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 4px;
  }

  /* 약속이 적용되는 시점 ─ 본문보다 작고 흐리게 */
  .privacy__when {
    font-weight: 400;
    font-size: 13px;
    line-height: 1.4;
    color: var(--lm-ink-quiet);
  }

  .privacy__promise {
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: var(--lm-ink);
    text-wrap: pretty;
    word-break: keep-all;
  }

  /* 세로로 쌓일 때는 설명을 먼저 읽히게 하고 목업을 아래에 둡니다. */
  @media (max-width: 900px) {
    .privacy__inner {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(36px, 5vw, 48px);
    }

    .privacy__device {
      order: 2;
    }

    .privacy__copy {
      order: 1;
    }

    .privacy__points {
      max-width: none;
    }
  }
</style>
