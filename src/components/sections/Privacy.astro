---
/**
 * "어디까지 기록할지는 내가 정합니다."
 * 왼쪽 목업은 기록마다 무엇을 담을지 고르는 화면 세 장(위치를 앞에, 사진 · 알림을 양옆 뒤에),
 * 오른쪽은 약속 두 가지입니다.
 *
 * 목업에 기기 테두리가 들어 있고 배경이 투명해서 이미지를 그대로 얹습니다.
 */
import { copy as c } from '../../lib/copy';

/**
 * 원본 캡처(376×916)는 내용 아래가 비어 있어 위쪽 640px만 잘라 썼습니다.
 * 배열 순서가 그리는 순서라, 앞에 보일 위치 화면을 마지막에 둡니다.
 */
const shots = [
  { key: 'photos', src: '/images/privacy-photos.webp', alt: c.privacy.alts.photos },
  { key: 'notifications', src: '/images/privacy-notifications.webp', alt: c.privacy.alts.notifications },
  { key: 'places', src: '/images/privacy-places.webp', alt: c.privacy.alts.places },
];
---

<section class="privacy" id="privacy">
  <div class="privacy__inner lm-page">
    <div class="privacy__device">
      {
        shots.map((shot) => (
          <img
            class={`privacy__phone privacy__phone--${shot.key}`}
            src={shot.src}
            alt={shot.alt}
            width="376"
            height="640"
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </div>

    <div class="privacy__copy">
      <h2 class="lm-h2 privacy__title">
        {c.privacy.titleLine1}<br />{c.privacy.titleLine2}
      </h2>
      <ul class="privacy__points">
        {
          c.privacy.points.map((point) => (
            <li class="privacy__point">
              <span class="privacy__when">{point.label}</span>
              <span class="privacy__promise">{point.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .privacy__inner {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: clamp(40px, 5.5vw, 80px);
    padding: var(--lm-section-y) var(--lm-gutter);
  }

  /* 세 폰을 부채꼴로 겹쳐 놓는 자리. 캡처가 1배 크기라 한 장이 376px을 넘지 않게 둡니다. */
  .privacy__device {
    position: relative;
    flex-shrink: 0;
    width: min(560px, 100%);
    aspect-ratio: 560 / 620;
  }

  /*
   * 목업에 기기 테두리가 들어 있어 그림자만 더합니다.
   * 잘라 낸 아래쪽은 흐리게 풀어 화면이 이어진다는 걸 남깁니다.
   */
  .privacy__phone {
    position: absolute;
    display: block;
    width: 54%;
    height: auto;
    filter: drop-shadow(0 18px 40px rgb(31 28 23 / 18%));
    -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
  }

  .privacy__phone--photos {
    top: 6%;
    left: 0;
    transform: rotate(-8deg);
  }

  .privacy__phone--notifications {
    top: 6%;
    right: 0;
    transform: rotate(8deg);
  }

  .privacy__phone--places {
    top: 0;
    left: 23%;
  }

  .privacy__copy {
    flex: 1;
    min-width: 0;
  }

  /*
   * 두 문장뿐이라 구분선 대신 여백으로 뗍니다.
   * 문장 안 줄간격(24px)보다 확실히 넓어야 두 문장으로 읽힙니다.
   */
  .privacy__points {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 480px;
  }

  .privacy__point {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 4px;
  }

  /* 약속이 적용되는 시점 ─ 본문보다 작고 흐리게 */
  .privacy__when {
    font-weight: 400;
    font-size: 13px;
    line-height: 1.4;
    color: var(--lm-ink-quiet);
  }

  .privacy__promise {
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: var(--lm-ink);
    text-wrap: pretty;
    word-break: keep-all;
  }

  /* 세로로 쌓일 때는 설명을 먼저 읽히게 하고 목업을 아래에 둡니다. */
  @media (max-width: 900px) {
    .privacy__inner {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(36px, 5vw, 48px);
    }

    .privacy__device {
      order: 2;
      align-self: center;
    }

    .privacy__copy {
      order: 1;
    }

    .privacy__points {
      max-width: none;
    }
  }
</style>
