---
/**
 * "기억은 흐려지고, 기록은 자꾸 미뤄집니다."
 * 사진 두 장(퇴근길 · 밤의 빈 일기)을 나란히 깔고 질문을 얹습니다.
 * 넓은 화면에서는 한 무대에 두 장이 붙어 있고, 좁은 화면에서는 사진마다 질문이 붙어 세로로 쌓입니다.
 */
import { getLangFromUrl, useCopy } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);

/**
 * 사진은 시안대로 좌우를 뒤집어 씁니다.
 * 밤 사진은 위쪽(휴대폰 화면)이 보여야 해서 위를 기준으로 자릅니다.
 */
const photos = [
  { src: '/images/problem-commute.webp', position: 'center' },
  { src: '/images/problem-night.webp', position: 'center top' },
];
---

<section class="problem" id="problem">
  <div class="problem__stage">
    <h2 class="problem__title">{c.problem.title}</h2>

    <div class="problem__panels">
      {
        c.problem.panels.map((panel, i) => (
          <figure class="problem__panel">
            <img
              class="problem__photo"
              src={photos[i].src}
              alt={panel.alt}
              style={`object-position: ${photos[i].position}`}
              width="1086"
              height="1448"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="problem__caption">
              <strong class="problem__caption-title">{panel.title}</strong>
              <span class="problem__caption-body">{panel.body}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <p class="problem__bridge">{c.problem.bridge}</p>
</section>

<style>
  .problem {
    background: var(--lm-dark);
    color: #ffffff;
  }

  .problem__stage {
    position: relative;
    width: 100%;
    max-width: var(--lm-page-max);
    margin-inline: auto;
    /* 시안 1440px 기준 760px */
    height: clamp(560px, 52.8vw, 760px);
    overflow: hidden;
  }

  .problem__title {
    position: absolute;
    z-index: 3;
    left: var(--lm-gutter);
    right: var(--lm-gutter);
    top: clamp(56px, 6.7vw, 96px);
    margin: 0;
    text-align: center;
    font-family: var(--lm-font-heading);
    font-weight: 700;
    font-size: clamp(26px, 3.2vw, 46px);
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .problem__panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100%;
  }

  .problem__panel {
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .problem__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
  }

  /* 두 사진이 가운데 이음새에서 어둠으로 녹아들도록 */
  .problem__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgb(18 19 26 / 30%) 0%,
      transparent 30%,
      transparent 60%,
      var(--lm-dark) 100%
    );
  }

  .problem__panel:last-child::before {
    background: linear-gradient(
      270deg,
      rgb(18 19 26 / 30%) 0%,
      transparent 30%,
      transparent 60%,
      var(--lm-dark) 100%
    );
  }

  /* 위아래를 어둡게 눌러 제목과 질문이 읽히게 */
  .problem__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(18 19 26 / 88%) 0%,
      rgb(18 19 26 / 35%) 30%,
      transparent 55%,
      rgb(18 19 26 / 92%) 100%
    );
  }

  .problem__caption {
    position: absolute;
    z-index: 3;
    left: var(--lm-gutter);
    right: clamp(20px, 4.2vw, 60px);
    bottom: clamp(40px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .problem__panel:last-child .problem__caption {
    left: clamp(20px, 4.2vw, 60px);
    right: var(--lm-gutter);
  }

  .problem__caption-title {
    font-weight: 700;
    font-size: clamp(20px, 2.1vw, 30px);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .problem__caption-body {
    font-weight: 400;
    font-size: clamp(15px, 1.3vw, 19px);
    line-height: 1.7;
    color: var(--lm-dark-soft);
    text-wrap: pretty;
  }

  .problem__bridge {
    margin: 0 auto;
    max-width: var(--lm-page-max);
    box-sizing: border-box;
    padding: clamp(32px, 3vw, 44px) var(--lm-gutter) clamp(40px, 3.6vw, 52px);
    text-align: center;
    font-weight: 600;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.6;
    color: var(--lm-primary-soft);
    text-wrap: pretty;
  }

  /* 좁은 화면 ─ 제목을 흐름에 두고, 사진마다 질문을 붙여 세로로 쌓습니다. */
  @media (max-width: 820px) {
    .problem__stage {
      height: auto;
      display: flex;
      flex-direction: column;
    }

    .problem__stage::after {
      content: none;
    }

    .problem__title {
      position: static;
      padding: clamp(56px, 12vw, 80px) var(--lm-gutter) 32px;
    }

    .problem__panels {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }

    .problem__panel {
      height: clamp(380px, 110vw, 480px);
    }

    .problem__panel::before,
    .problem__panel:last-child::before {
      background: linear-gradient(
        180deg,
        rgb(18 19 26 / 40%) 0%,
        transparent 35%,
        rgb(18 19 26 / 90%) 100%
      );
    }

    .problem__caption,
    .problem__panel:last-child .problem__caption {
      left: var(--lm-gutter);
      right: var(--lm-gutter);
      bottom: 28px;
      gap: 8px;
    }
  }
</style>
