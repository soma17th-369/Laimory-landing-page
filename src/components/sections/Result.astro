---
/**
 * "흩어진 순간을, 다시 읽을 수 있는 하루로."
 * 왼쪽은 모아 오는 기록 네 가지(데모의 소스 아이콘과 같은 순서), 오른쪽은 기록 카드 → 타임라인 카드 데모입니다.
 */
import SourceBadge from '../SourceBadge.astro';
import { sourceLooks } from '../../lib/sources';
import { getLangFromUrl, useCopy } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);

/** 기록 카드에 겹쳐 보이는 사진 조각 두 장. */
const frags = ['/images/frag-1.webp', '/images/frag-2.webp'];
---

<section class="result" id="result">
  <div class="result__inner lm-page">
    <div class="result__copy">
      <h2 class="lm-h2 result__title">
        {c.result.titleLine1}<br />{c.result.titleLine2}
      </h2>
      <p class="result__body">{c.result.body}</p>
    </div>

    <div class="demo" role="group" aria-label={c.result.demoLabel}>
      <ul class="demo__sources">
        {
          c.result.sources.map((source, i) => (
            <li class="lm-card demo__source">
              <SourceBadge icon={sourceLooks[i].icon} tone={sourceLooks[i].tone} size={36} iconSize={18} />
              <span class="demo__source-text">
                <span class="demo__source-title">{source.title}</span>
                <span class="demo__source-meta">{source.meta}</span>
              </span>
              {i === 0 && (
                <span class="demo__thumbs" aria-hidden="true">
                  <img src={frags[0]} alt="" width="26" height="26" loading="lazy" decoding="async" />
                  <img src={frags[1]} alt="" width="26" height="26" loading="lazy" decoding="async" />
                </span>
              )}
            </li>
          ))
        }
      </ul>

      <span class="demo__arrow" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <path
            d="M4 14h19M15 6l8 8-8 8"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>

      <div class="demo__card">
        <div class="demo__shot-clip">
          <img
            class="demo__shot"
            src="/images/result-timeline.webp"
            alt=""
            width="1080"
            height="1785"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .result__inner {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: clamp(40px, 5.5vw, 80px);
    padding: var(--lm-section-y) var(--lm-gutter);
  }

  .result__copy {
    flex: 1;
    min-width: 0;
  }

  .result__body {
    margin: 20px 0 0;
    max-width: 30em;
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.8;
    color: var(--lm-ink);
    text-wrap: pretty;
    word-break: keep-all;
  }

  /* 데모 ─ 기록 카드 → 타임라인 카드 */
  .demo {
    display: flex;
    align-items: center;
    gap: 16px;
    width: min(640px, 100%);
    flex-shrink: 0;
  }

  .demo__sources {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .demo__source {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-radius: 14px;
  }

  .demo__source-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .demo__source-title {
    font-weight: 600;
    font-size: 14px;
    line-height: 1;
    color: var(--lm-ink);
    white-space: nowrap;
  }

  .demo__source-meta {
    font-family: var(--lm-font-label);
    font-weight: 400;
    font-size: 12px;
    line-height: 1;
    color: var(--lm-ink-faint);
    white-space: nowrap;
  }

  .demo__thumbs {
    display: flex;
    gap: 4px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .demo__thumbs img {
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    object-fit: cover;
  }

  .demo__arrow {
    display: flex;
    color: var(--lm-primary);
    flex-shrink: 0;
  }

  /*
   * 타임라인 카드 ─ 실제 앱 화면 캡처를 담는 틀.
   * 캡처 배경이 섹션 배경과 비슷해 그냥 얹힌 것처럼 보이므로,
   * 안쪽 여백으로 흰 테두리를 두르고 그림자로 띄워 액자처럼 보이게 합니다.
   */
  .demo__card {
    flex: 1.4;
    min-width: 0;
    padding: 6px;
    box-sizing: border-box;
    border-radius: var(--lm-radius-card);
    background: var(--lm-surface);
    box-shadow:
      0 18px 40px -14px rgb(31 28 23 / 22%),
      0 4px 10px -4px rgb(31 28 23 / 10%),
      inset 0 0 0 2px var(--lm-outline);
  }

  /*
   * 캡처가 세로로 길어 그대로 두면 왼쪽 기록 카드보다 훨씬 커집니다.
   * 높이를 잘라 두고 아래를 흐리게 풀어 하루가 이어진다는 걸 남깁니다.
   */
  /*
   * 캡처 배경(#faf8f4)이 페이지 배경과 거의 같아 경계가 안 보입니다.
   * 얇은 흰 여백과 바깥 선이 그 경계를 대신합니다.
   */
  .demo__shot-clip {
    position: relative;
    max-height: 428px;
    overflow: hidden;
    border-radius: 14px;
  }

  .demo__shot-clip::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 80px;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--lm-surface));
  }

  .demo__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 데모가 들어갈 자리가 없으면 설명 아래로 내립니다. */
  @media (max-width: 1100px) {
    .result__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .demo {
      width: 100%;
    }
  }

  /*
   * 아주 좁으면 기록 카드 → 화살표 → 타임라인을 세로로 세웁니다.
   * 폰에서는 왼쪽 목록과 데모 카드가 위아래로 붙어 같은 내용이 두 번 나오므로
   * 목록은 감추고, 카드 4장을 2×2로 눕혀 '흩어진 기록 → 하루 한 장'이
   * 한 화면 안에 들어오게 합니다.
   */
  @media (max-width: 600px) {
    .demo {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-top: 28px;
    }

    .demo__sources {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      flex: none;
    }

    /* 2×2에서는 아이콘과 제목만 ─ 시간·장소와 사진 조각은 타임라인 카드가 보여 줍니다. */
    .demo__source {
      gap: 10px;
      padding: 14px 12px;
    }

    .demo__source-title {
      white-space: normal;
    }

    .demo__source-meta,
    .demo__thumbs {
      display: none;
    }

    .demo__card {
      flex: none;
    }

    /* 세로로 쌓이면 자리가 넉넉하니 하루를 조금 더 보여 줍니다. */
    .demo__shot-clip {
      max-height: 468px;
    }

    .demo__arrow {
      align-self: center;
      transform: rotate(90deg);
    }
  }
</style>
