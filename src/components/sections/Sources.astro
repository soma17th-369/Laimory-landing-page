---
/**
 * "라이모리는 내 기록을 어디서 가져오나요?"
 * 사진 · 일정 · 알림 · 위치를 각각 어디서 어떻게 읽는지, 그리고 언제 밖으로 나가는지를
 * 사용자 안내 말투로 풀어 둡니다.
 *
 * 제목과 소개는 늘 보이고, 항목별 자세한 내용은 눌러야 펼쳐집니다(<details>).
 * 스크립트 없이 키보드 · 화면 낭독기로도 열고 닫을 수 있습니다.
 */
import Icon from '../Icon.astro';
import SourceBadge from '../SourceBadge.astro';
import type { IconName } from '../../lib/icons';
import type { Tone } from '../../lib/sources';
import { copy as c, type SiteCopy } from '../../lib/copy';

type ItemKey = SiteCopy['sources']['items'][number]['key'];

/** 항목별 아이콘 배지. 사진 · 일정 · 위치는 위쪽 기록 데모와 같은 색입니다. */
const looks: Record<ItemKey, { icon: IconName; tone: Tone }> = {
  photo: { icon: 'camera', tone: 'joy' },
  calendar: { icon: 'calendar', tone: 'calm' },
  notification: { icon: 'bell', tone: 'purple' },
  place: { icon: 'pin', tone: 'green' },
  outbound: { icon: 'lock', tone: 'calm' },
};

/** '**굵게**' 표시를 잘라 [일반, 굵게, 일반, …] 조각으로 나눕니다. */
const parts = (text: string) => text.split(/\*\*(.+?)\*\*/g);
---

<section class="sources" id="sources">
  <div class="sources__inner lm-page">
    <div class="sources__copy">
      <h2 class="lm-h2 sources__title">{c.sources.title}</h2>
      <p class="sources__intro">{c.sources.intro}</p>
    </div>

    <div class="sources__list">
      {
        c.sources.items.map((item) => (
          <details class={`acc acc--${item.key}`}>
            <summary class="acc__summary">
              <SourceBadge icon={looks[item.key].icon} tone={looks[item.key].tone} size={40} iconSize={20} />
              <span class="acc__head">
                <span class="acc__name">{item.name}</span>
                <span class="acc__from">{item.from}</span>
              </span>
              <span class="acc__chevron" aria-hidden="true">
                <Icon name="chevronDown" size={20} />
              </span>
            </summary>

            <ul class="acc__points">
              {item.points.map((point) => {
                const text = typeof point === 'string' ? point : point.text;
                return (
                  <li>
                    {parts(text).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}
                    {typeof point !== 'string' && (
                      <ul class="acc__sub">
                        {point.sub.map((sub) =>
                          typeof sub === 'string' ? (
                            <li>{sub}</li>
                          ) : (
                            <li>
                              {sub.text}
                              <span class="acc__note">{sub.note}</span>
                            </li>
                          ),
                        )}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sources {
    background: var(--lm-paper-2);
  }

  .sources__inner {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    align-items: start;
    gap: clamp(40px, 5.5vw, 80px);
    padding: var(--lm-section-y) var(--lm-gutter);
  }

  /* 넓은 화면에서는 목록을 펼쳐 내려가도 제목이 따라옵니다. */
  .sources__copy {
    position: sticky;
    top: 32px;
  }

  .sources__title {
    max-width: 14em;
  }

  .sources__intro {
    margin: 20px 0 0;
    max-width: 30em;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.8;
    color: var(--lm-ink);
    text-wrap: pretty;
    word-break: keep-all;
  }

  .sources__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ── 펼침 항목 ── */
  .acc {
    border-radius: var(--lm-radius-tile);
    background: var(--lm-surface);
    box-shadow: inset 0 0 0 1px var(--lm-outline-2);
    transition: box-shadow 200ms ease;
  }

  .acc[open] {
    box-shadow:
      inset 0 0 0 1px var(--lm-outline),
      0 12px 28px -18px rgb(31 28 23 / 25%);
  }

  /* '언제 밖으로 나가나요'는 약속이라 옅은 남색 바탕으로 따로 보이게 합니다. */
  .acc--outbound {
    margin-top: 8px;
    background: var(--lm-primary-container);
    box-shadow: none;
  }

  .acc--outbound[open] {
    box-shadow: 0 12px 28px -18px rgb(38 46 70 / 35%);
  }

  .acc__summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }

  .acc__summary::-webkit-details-marker {
    display: none;
  }

  .acc__summary:focus-visible {
    outline: 2px solid var(--lm-primary);
    outline-offset: 2px;
  }

  .acc__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .acc__name {
    font-weight: 700;
    font-size: 16px;
    line-height: 1.4;
    color: var(--lm-ink);
    word-break: keep-all;
  }

  .acc__from {
    font-size: 14px;
    line-height: 1.5;
    color: var(--lm-ink-muted);
    word-break: keep-all;
  }

  .acc--outbound .acc__from {
    color: var(--lm-on-primary-container);
  }

  .acc__chevron {
    display: flex;
    flex-shrink: 0;
    color: var(--lm-ink-quiet);
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .acc[open] .acc__chevron {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .acc__summary:hover .acc__chevron {
      color: var(--lm-ink);
    }
  }

  /* 펼친 내용 ─ 배지 오른쪽 글줄에 맞춰 들여 씁니다(배지 40 + 간격 14). */
  .acc__points {
    margin: 0;
    padding: 0 22px 22px calc(20px + 54px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    /* Tailwind 기본 스타일이 목록 점을 지우므로 다시 켭니다. */
    list-style: disc;
  }

  .acc__points li,
  .acc__sub li {
    font-size: 15px;
    line-height: 1.7;
    color: var(--lm-ink);
    text-wrap: pretty;
    word-break: keep-all;
  }

  .acc__points > li::marker {
    color: var(--lm-primary);
  }

  .acc__points strong {
    font-weight: 700;
  }

  .acc__sub {
    margin: 8px 0 0;
    padding: 12px 16px 12px 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-radius: 12px;
    background: var(--lm-paper);
    list-style: circle;
  }

  .acc--outbound .acc__sub {
    background: rgb(255 255 255 / 55%);
  }

  .acc__sub li {
    font-size: 14px;
    color: var(--lm-ink);
  }

  .acc__note {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    color: var(--lm-ink-muted);
  }

  /* 펼칠 때 내용이 살짝 내려오며 나타납니다. */
  .acc[open] .acc__points {
    animation: acc-open 260ms cubic-bezier(0.05, 0.7, 0.1, 1);
  }

  @keyframes acc-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acc[open] .acc__points {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .sources__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .sources__copy {
      position: static;
    }
  }

  /* 폰에서는 들여쓰기를 줄여 글줄을 넓게 씁니다. */
  @media (max-width: 600px) {
    .acc__summary {
      gap: 12px;
      padding: 16px;
    }

    .acc__points {
      padding: 0 18px 20px 36px;
    }

    .acc__sub {
      padding: 10px 12px 10px 26px;
    }
  }
</style>
