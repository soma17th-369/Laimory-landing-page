---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="cta" class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
  <div class="relative overflow-hidden rounded-3xl bg-brand px-6 py-16 text-center sm:px-16">
    <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {t('cta.title')}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-indigo-100">{t('cta.subtitle')}</p>
    <a
      href="#"
      class="mt-8 inline-block rounded-full bg-white px-8 py-3 text-base font-semibold text-brand transition hover:bg-indigo-50"
    >
      {t('cta.button')}
    </a>
  </div>
</section>
