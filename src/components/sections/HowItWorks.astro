---
/**
 * "한 번 연결해두면, 그다음은 알아서 모입니다."
 * 제목이 말하는 '연결'을 설정 화면 한 장으로 보여 주고, 설명은 한 문장만 답니다.
 *
 * 타임라인 화면은 히어로에서 이미 크게 보여 주고, 확인·편집 화면과 그 설명은
 * 바로 다음 개인정보 섹션이 맡으므로 이 섹션에는 설정 화면만 남깁니다.
 *
 * 제목과 설명은 다른 섹션처럼 왼쪽에 맞추고, 목업만 가운데에 둡니다.
 * (앞뒤 Result · 개인정보가 모두 좌우 배치라 여기까지 좌우로 나누지는 않습니다.)
 */
import PhoneFrame from '../PhoneFrame.astro';
import AppShot from '../AppShot.astro';
import { getLangFromUrl, useCopy } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);

/** 설정 화면 캡처. width · height는 파일의 실제 픽셀 크기입니다(2배 해상도). */
const shot = { src: '/images/app-settings.webp', width: 824, height: 1408 };
---

<section class="how" id="how">
  <div class="how__inner lm-page">
    <h2 class="lm-h2 how__title">{c.how.title}</h2>
    <p class="how__body">{c.how.body}</p>

    <div class="how__device">
      <PhoneFrame width={360} height={430} size="sm" label={c.how.alt}>
        <AppShot src={shot.src} width={shot.width} height={shot.height} />
      </PhoneFrame>
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--lm-paper-2);
  }

  .how__inner {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(18px, 2vw, 26px);
    padding: clamp(64px, 6.7vw, 96px) var(--lm-gutter) var(--lm-section-y);
  }

  /* 두 줄 정도로 모아 두되, 한글 단어 중간에서는 끊지 않습니다. */
  .how__title {
    max-width: 16em;
    word-break: keep-all;
  }

  .how__body {
    margin: 0;
    max-width: 40em;
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.8;
    color: var(--lm-ink-muted);
    text-wrap: pretty;
    word-break: keep-all;
  }

  /* 글은 왼쪽에 맞추되 목업은 가운데 ─ 넓은 화면에서 한쪽이 비지 않도록 */
  .how__device {
    align-self: center;
    display: flex;
    justify-content: center;
    margin-top: clamp(10px, 1.4vw, 18px);
  }

  /*
   * 목업 아래가 잘린 자리를 흐리게 풀어, 잘린 그림이 아니라 이어지는 화면으로 읽히게.
   * 데이터 소스 네 줄이 다 보인 뒤에 흐려지도록 시작점을 늦춰 둡니다.
   */
  .how__device :global(.phone) {
    -webkit-mask-image: linear-gradient(to bottom, #000 85%, transparent);
    mask-image: linear-gradient(to bottom, #000 85%, transparent);
  }
</style>
