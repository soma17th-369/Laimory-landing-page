---
/**
 * "한 번 연결해두면, 그다음은 알아서 모입니다."
 * 제목이 말하는 '연결'을 설정 화면 한 장으로 보여 주고, 설명은 한 문장만 답니다.
 *
 * 타임라인 화면은 히어로에서 이미 크게 보여 주고, 확인·편집 화면과 그 설명은
 * 바로 다음 개인정보 섹션이 맡으므로 이 섹션에는 설정 화면만 남깁니다.
 *
 * 넓은 화면에서는 글이 왼쪽, 목업이 오른쪽입니다. 바로 다음 개인정보 섹션이
 * 목업 왼쪽 · 글 오른쪽이라 좌우가 번갈아 놓입니다.
 * 좁은 화면에서는 글 아래에 목업이 가운데로 놓입니다.
 */
import { getLangFromUrl, useCopy } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);

/**
 * 설정 화면을 담은 폰 목업. 기기 테두리까지 그림에 들어 있고 배경이
 * 투명해서, 목업 틀을 CSS로 그리지 않고 이미지를 그대로 얹습니다.
 */
const shot = { src: '/images/how-phone.webp', width: 843, height: 967 };
---

<section class="how" id="how">
  <div class="how__inner lm-page">
    <div class="how__copy">
      <h2 class="lm-h2 how__title">{c.how.title}</h2>
      <p class="how__body">{c.how.body}</p>
    </div>

    <div class="how__device">
      <img
        class="how__phone"
        src={shot.src}
        alt={c.how.alt}
        width={shot.width}
        height={shot.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--lm-paper-2);
  }

  .how__inner {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: clamp(40px, 5.5vw, 80px);
    padding: clamp(64px, 6.7vw, 96px) var(--lm-gutter) var(--lm-section-y);
  }

  .how__copy {
    flex: 1;
    min-width: 0;
  }

  /* 두 줄 정도로 모아 두되, 한글 단어 중간에서는 끊지 않습니다. */
  .how__title {
    max-width: 16em;
    word-break: keep-all;
  }

  .how__body {
    margin: clamp(18px, 2vw, 26px) 0 0;
    max-width: 40em;
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.8;
    color: var(--lm-ink);
    text-wrap: pretty;
    word-break: keep-all;
  }

  .how__device {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
    width: min(360px, 100%);
  }

  /* 좁은 화면 ─ 글 아래에 목업을 가운데로 놓습니다. */
  @media (max-width: 900px) {
    .how__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(18px, 2vw, 26px);
    }

    .how__copy {
      width: 100%;
    }

    .how__device {
      align-self: center;
      margin-top: clamp(10px, 1.4vw, 18px);
    }
  }

  /*
   * 목업에 기기 테두리가 들어 있어 그림자만 더합니다.
   * 아래는 흐리게 풀어 화면이 이어진다는 걸 남깁니다. 데이터 소스 다섯 줄 중
   * 알림까지(85%)는 또렷하게 두고 헬스(85~94%) 구간에서 사라집니다.
   */
  .how__phone {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 40px rgb(31 28 23 / 18%));
    -webkit-mask-image: linear-gradient(to bottom, #000 85%, transparent 98%);
    mask-image: linear-gradient(to bottom, #000 85%, transparent 98%);
  }
</style>
