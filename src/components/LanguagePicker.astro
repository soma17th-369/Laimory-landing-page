---
/**
 * 언어 전환. 지금은 홈만 있으므로 각 언어의 홈으로 이동합니다.
 * 페이지가 늘어나면 현재 경로를 기준으로 매핑하도록 확장하세요.
 */
import { getLangFromUrl } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const options = [
  { code: 'ko' as const, href: '/', short: 'KO' },
  { code: 'en' as const, href: '/en/', short: 'EN' },
];
---

<div class="picker">
  {
    options.map((option) => (
      <a
        href={option.href}
        class:list={['picker__item', { 'picker__item--on': option.code === lang }]}
        hreflang={option.code}
        lang={option.code}
        aria-current={option.code === lang ? 'true' : undefined}
        title={languages[option.code]}
      >
        {option.short}
      </a>
    ))
  }
</div>

<style>
  .picker {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: rgb(255 255 255 / 7%);
  }

  .picker__item {
    padding: 6px 10px;
    border-radius: 999px;
    font-family: var(--lm-font-label);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--lm-primary-dim);
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .picker__item:hover {
    color: #ffffff;
  }

  .picker__item--on {
    background: rgb(255 255 255 / 10%);
    color: #ffffff;
  }

  @media (max-width: 480px) {
    .picker__item {
      padding: 5px 8px;
      font-size: 11px;
    }
  }
</style>
