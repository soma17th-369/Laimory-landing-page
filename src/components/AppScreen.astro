---
/**
 * 폰 목업 안에 들어가는 Laimory 앱 화면.
 * 원본 디자인(412px 기준)의 간격과 크기를 그대로 옮기되,
 * 고정 폭 대신 flex로 늘어나게 만들어 좁은 화면에서도 깨지지 않습니다.
 */
import Icon from './Icon.astro';
import MoodFace from './MoodFace.astro';
import { type Emotion } from '../lib/moods';
import type { SiteCopy } from '../i18n/ui';

interface Props {
  app: SiteCopy['app'];
  mood: SiteCopy['mood'];
}

const { app, mood } = Astro.props;

/** 감정 칩 ─ 시안에서는 '평온'이 선택된 상태입니다. */
const moodChips: { emotion: Emotion; label: string }[] = [
  { emotion: 'joy', label: mood.joy },
  { emotion: 'calm', label: mood.calm },
  { emotion: 'mellow', label: mood.mellow },
  { emotion: 'weary', label: mood.weary },
  { emotion: 'down', label: mood.down },
];
const selected: Emotion = 'calm';

/** 사진 자리 표시용 톤 */
const photoTones = ['#d1cbc5', '#c4beb9', '#b8b2ad'];

/**
 * 시간 범위는 좁은 칸에 들어가야 해서 시작/끝을 각각 한 줄로 끊어 씁니다.
 * 물결표(~)와 en dash(–) 모두 구분자로 봅니다.
 */
const splitTime = (time: string) => time.split(/\s*[~–]\s*/);
---

<div class="screen">
  <!-- 상태 표시줄 -->
  <div class="status">
    <span class="status__time">{app.time}</span>
    <span class="status__battery"></span>
  </div>

  <!-- 날짜 헤더 -->
  <div class="topbar">
    <span class="topbar__icon"><Icon name="caretLeft" size={20} /></span>
    <span class="topbar__date">{app.date}</span>
    <span class="topbar__icon"><Icon name="dots" size={20} /></span>
  </div>

  <div class="content">
    <!-- AI 안내 카드 -->
    <div class="notice">
      <span class="notice__icon"><Icon name="sparkle" size={22} /></span>
      <div class="stack-2">
        <span class="notice__title">{app.aiTitle}</span>
        <span class="notice__body">{app.aiBody}</span>
      </div>
    </div>

    <!-- 감정 고르기 -->
    <div class="mood">
      <div class="mood__head">
        <span class="mood__icon"><Icon name="sparkle" size={16} /></span>
        <div class="stack-2">
          <span class="notice__title">{app.moodTitle}</span>
          <span class="notice__body">{app.moodBody}</span>
        </div>
      </div>
      <div class="mood__chips">
        {
          moodChips.map((chip) => (
            <div class:list={['chip', { 'chip--on': chip.emotion === selected }]}>
              <MoodFace emotion={chip.emotion} size={26} />
              <span class="chip__label">{chip.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 타임라인 -->
    <div class="timeline__head">
      <span class="timeline__label">{app.timelineLabel}</span>
      <span class="timeline__add">
        <Icon name="plus" size={12} />
        {app.add}
      </span>
    </div>

    <div class="timeline">
      {
        app.entries.map((entry) => (
          <div class="entry">
            <span class="entry__time">
              {splitTime(entry.time).map((part) => (
                <span class="entry__time-part">{part}</span>
              ))}
            </span>
            <span class="entry__rail">
              <span class="entry__dot" />
              <span class="entry__line" />
            </span>
            <div class="entry__body">
              <div class="event">
                <span class="event__icon">
                  <Icon name="alarm" size={22} />
                </span>
                <div class="stack-2 event__text">
                  <span class="event__title">{entry.title}</span>
                  {entry.place && <span class="event__place">{entry.place}</span>}
                </div>
                <span class="event__edit">
                  <Icon name="pencil" size={16} />
                </span>
              </div>

              {
                entry.photos && (
                  <div class="photos">
                    {photoTones.map((tone) => (
                      <span class="photos__item" style={`background:${tone}`} />
                    ))}
                  </div>
                )
              }

              <div class="note">{entry.note}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .screen {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--lm-paper);
    color: var(--lm-ink-muted);
    font-family: var(--lm-font-app);
  }

  .stack-2 {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  /* 상태 표시줄 */
  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    padding-inline: 20px;
    flex-shrink: 0;
  }

  .status__time {
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
    color: var(--lm-ink);
  }

  .status__battery {
    width: 24px;
    height: 12px;
    border-radius: 3px;
    background: var(--lm-ink);
  }

  /* 날짜 헤더 */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-inline: 16px;
    flex-shrink: 0;
  }

  .topbar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    color: var(--lm-ink);
  }

  .topbar__date {
    font-weight: 600;
    font-size: 16px;
    line-height: 1;
    color: var(--lm-ink);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 4px 20px 20px;
    min-width: 0;
  }

  /* AI 안내 카드 */
  .notice {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--lm-primary-container);
  }

  .notice__icon {
    color: var(--lm-on-primary-container);
    display: flex;
  }

  .notice__title {
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.2;
    color: var(--lm-ink);
  }

  .notice__body {
    font-weight: 400;
    font-size: 12px;
    line-height: 18px;
    color: var(--lm-ink-muted);
  }

  /* 감정 고르기 */
  .mood {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 14px 12px;
    border-radius: 14px;
    background: var(--lm-paper);
    box-shadow: inset 0 0 0 1px var(--lm-outline-2);
  }

  .mood__head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .mood__icon {
    color: var(--lm-on-primary-container);
    display: flex;
    padding-top: 1px;
  }

  .mood__chips {
    display: flex;
    gap: 6px;
  }

  .chip {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 0 8px;
    border-radius: 12px;
  }

  .chip--on {
    background: var(--lm-surface);
    box-shadow: inset 0 0 0 1.5px var(--lm-primary);
  }

  .chip__label {
    font-weight: 500;
    font-size: 10.5px;
    line-height: 1;
    color: var(--lm-ink-muted);
    white-space: nowrap;
  }

  .chip--on .chip__label {
    font-weight: 600;
    color: var(--lm-on-primary-container);
  }

  /* 타임라인 머리 */
  .timeline__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .timeline__label {
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.1em;
    color: var(--lm-ink-muted);
  }

  .timeline__add {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--lm-surface);
    box-shadow: inset 0 0 0 1px var(--lm-outline-2);
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    color: var(--lm-ink-muted);
    white-space: nowrap;
  }

  /* 타임라인 항목 */
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .entry {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding-bottom: 18px;
  }

  .entry__time {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 40px;
    flex-shrink: 0;
    padding-top: 1px;
    font-weight: 500;
    font-size: 11px;
    line-height: 1.45;
    color: var(--lm-ink-muted);
  }

  .entry__time-part {
    white-space: nowrap;
  }

  .entry__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 10px;
    flex-shrink: 0;
    align-self: stretch;
  }

  .entry__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lm-primary);
    flex-shrink: 0;
  }

  .entry__line {
    width: 1px;
    flex: 1;
    background: var(--lm-outline);
  }

  .entry__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  /* 사건 카드 */
  .event {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px;
    border-radius: 12px;
    background: var(--lm-surface);
  }

  .event__icon {
    display: flex;
    color: var(--lm-ink);
    flex-shrink: 0;
  }

  .event__text {
    padding-top: 1px;
  }

  .event__title {
    font-weight: 500;
    font-size: 13px;
    line-height: 1.3;
    color: var(--lm-ink);
  }

  .event__place {
    font-weight: 400;
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--lm-ink-muted);
  }

  .event__edit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--lm-paper-2);
    color: var(--lm-ink-muted);
    flex-shrink: 0;
  }

  /* 사진 자리 */
  .photos {
    display: flex;
    gap: 6px;
  }

  .photos__item {
    flex: 1;
    max-width: 64px;
    aspect-ratio: 1;
    border-radius: 4px;
  }

  /* 직접 쓴 한 줄 */
  .note {
    padding: 10px 12px;
    border-radius: 12px;
    outline: 1px dashed var(--lm-outline);
    outline-offset: -1px;
    font-family: var(--lm-font-serif);
    font-weight: 400;
    font-size: 13px;
    line-height: 20px;
    color: var(--lm-ink);
  }
</style>
