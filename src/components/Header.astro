---
/**
 * 상단 바. 히어로와 같은 네이비라 경계 없이 이어집니다.
 */
import Logo from './Logo.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useCopy, getLocalizedHome } from '../i18n/utils';
import { DOWNLOAD_URL, isExternal } from '../lib/links';

const lang = getLangFromUrl(Astro.url);
const c = useCopy(lang);
const home = getLocalizedHome(lang);

const links = [
  { href: '#problem', label: c.nav.problem },
  { href: '#how', label: c.nav.how },
  { href: '#privacy', label: c.nav.privacy },
];
---

<header class="header">
  <div class="header__inner">
    <a class="header__logo" href={home}>
      <Logo width={132} />
    </a>

    <nav class="header__nav">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="header__end">
      <LanguagePicker />
      <a
        class="lm-btn lm-btn--primary header__cta"
        href={DOWNLOAD_URL}
        rel={isExternal(DOWNLOAD_URL) ? "noopener" : undefined}
      >
        {c.nav.download}
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    background: var(--lm-navy);
  }

  .header__inner {
    width: 100%;
    max-width: var(--lm-page-max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(18px, 2vw, 28px) var(--lm-gutter);
    box-sizing: border-box;
  }

  .header__logo {
    display: block;
    color: #ffffff;
    flex-shrink: 0;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    margin-inline-start: auto;
  }

  .header__nav a {
    font-weight: 500;
    font-size: 15px;
    line-height: 1;
    color: var(--lm-primary-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .header__nav a:hover {
    color: #ffffff;
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .header__cta {
    padding: 12px 22px;
    font-size: 15px;
  }

  /* 좁은 화면에서는 앵커 링크를 접고 로고와 CTA만 남깁니다. */
  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }

    .header__end {
      margin-inline-start: auto;
    }
  }

  @media (max-width: 480px) {
    .header__logo :global(svg) {
      width: 104px;
    }

    .header__cta {
      padding: 10px 16px;
      font-size: 14px;
    }
  }
</style>
