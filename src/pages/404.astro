---
/**
 * 404 페이지.
 *
 * 정적 빌드에서는 어떤 주소로 들어왔는지 서버가 알려주지 않아 언어를 판별할 수 없습니다.
 * 그래서 기본 언어인 한국어를 기준으로 두되, 영어 안내를 함께 적어 둡니다.
 *
 * dist/404.html로 나가면 Vercel이 자동으로 잡아 주므로 별도 설정은 필요 없습니다.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="페이지를 찾을 수 없습니다 — Laimory" noindex>
  <section class="notfound lm-section lm-page">
    <span class="notfound__code">404</span>
    <h1 class="notfound__title">페이지를 찾을 수 없습니다</h1>
    <p class="notfound__body">
      주소가 바뀌었거나 삭제된 페이지입니다.
      <span lang="en">This page could not be found.</span>
    </p>
    <div class="notfound__actions">
      <a class="lm-btn lm-btn--primary notfound__cta" href="/">홈으로</a>
      <a class="notfound__link" href="/en/" lang="en">English</a>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* 헤더와 푸터 사이가 허전하지 않도록 최소 높이를 줍니다. */
    min-height: 46vh;
    justify-content: center;
  }

  .notfound__code {
    font-family: var(--lm-font-label);
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--lm-ink-faint);
  }

  .notfound__title {
    margin: 18px 0 0;
    font-weight: 700;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--lm-ink);
    text-wrap: pretty;
  }

  .notfound__body {
    margin: 20px 0 0;
    max-width: 420px;
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.85;
    color: var(--lm-ink-muted);
    text-wrap: pretty;
  }

  .notfound__body span {
    display: block;
    color: var(--lm-ink-faint);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 36px;
  }

  .notfound__cta {
    padding: 16px 32px;
    font-size: 16px;
  }

  .notfound__link {
    font-weight: 500;
    font-size: 15px;
    color: var(--lm-ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--lm-outline);
    padding-bottom: 2px;
  }

  .notfound__link:hover {
    color: var(--lm-ink);
    border-bottom-color: var(--lm-ink);
  }
</style>
